# ============================================================
# GitOracle — Environment Configuration Template
# ============================================================
# Copy this file to '.env' and fill in your keys.
# DO NOT commit the '.env' file to Git — it contains your secrets.
# ============================================================

# ── GitHub ───────────────────────────────────────────────────
# Optional but STRONGLY recommended (increases rate limit from 60 to 5,000 req/hr).
# Get a token at: github.com → Settings → Developer settings
#                 → Personal access tokens → Tokens (classic)
# Required scope: public_repo (read-only is fine)
GITHUB_TOKEN=enter_your_github_token_here

# ── LLM Backend ──────────────────────────────────────────────
# Choose: "ollama" (local, free) or "groq" (cloud, free tier)
LLM_BACKEND=groq

# -- Ollama settings (used when LLM_BACKEND=ollama) ----------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# -- Groq settings (used when LLM_BACKEND=groq) --------------
# Get a free API key at: console.groq.com
GROQ_API_KEY=enter_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Cache ────────────────────────────────────────────────────
# How long (seconds) GitHub API responses are cached locally.
CACHE_TTL_SECONDS=60
CACHE_ENABLED=true

# ── Memory ───────────────────────────────────────────────────
# Max number of conversation turns kept in memory per session.
MAX_HISTORY_TURNS=20

# ── Logging ──────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
